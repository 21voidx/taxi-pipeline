# Identity / isolation
COMPOSE_PROJECT_NAME=ride-hailing-development
ENVIRONMENT=development
DEPLOY_ROOT=/opt/data-platform-development

# Host runtime ownership
AIRFLOW_UID=1001
DOCKER_GID=988

# Images - replace YOUR_GITHUB_USER/YOUR_REPOSITORY before first bootstrap
AIRFLOW_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-airflow:development-runtime
DBT_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-dbt:development-runtime
GENERATOR_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-generator:development-runtime

# Ports
AIRFLOW_BIND_ADDRESS=0.0.0.0
AIRFLOW_PORT=8011
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8091
POSTGRES_SOURCE_BIND_ADDRESS=127.0.0.1
POSTGRES_SOURCE_PORT=5434

# PostgreSQL source
POSTGRES_SOURCE_DB=ride_hailing
POSTGRES_SOURCE_USER=ride_user
POSTGRES_SOURCE_PASSWORD=CHANGE_ME

# Airflow metadata DB
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# Airflow secrets / bootstrap admin
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__CORE__SECRET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME
AIRFLOW_DAGS_PAUSED_AT_CREATION=true

# GCP / BigQuery
GCP_PROJECT_ID=taxi-pipeline-484508
GCP_CREDENTIALS_HOST_PATH=/home/void/credentials/service-account.json
BQ_RAW_DATASET=dev_raw_ride_hailing
BQ_ANALYTICS_DATASET=analytics_ride_hailing
BQ_MART_DATASET=mart_ride_hailing

# dbt
DBT_TARGET=dev

# Trino
TRINO_CATALOG_POSTGRES=postgresql
TRINO_CATALOG_BIGQUERY=bigquery

# Generator
GENERATOR_SEED=42
GENERATOR_BOOTSTRAP_DAYS=14
GENERATOR_BOOTSTRAP_RIDES_PER_DAY=200
GENERATOR_CUSTOMER_COUNT=2000
GENERATOR_DRIVER_COUNT=200
GENERATOR_INTERVAL_SECONDS=30
GENERATOR_RIDES_PER_TICK=2

TZ=Asia/Jakarta
