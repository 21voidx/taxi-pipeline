# Identity / isolation
COMPOSE_PROJECT_NAME=ride-hailing-production
ENVIRONMENT=production
DEPLOY_ROOT=/opt/data-platform-production

# Host runtime ownership
AIRFLOW_UID=1001
DOCKER_GID=988

# Images - replace YOUR_GITHUB_USER/YOUR_REPOSITORY before first bootstrap
AIRFLOW_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-airflow:production-runtime
DBT_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-dbt:production-runtime
GENERATOR_IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/YOUR_REPOSITORY-generator:production-runtime

# Ports
AIRFLOW_BIND_ADDRESS=0.0.0.0
AIRFLOW_PORT=8010
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8090
POSTGRES_SOURCE_BIND_ADDRESS=127.0.0.1
POSTGRES_SOURCE_PORT=5433

# PostgreSQL source
POSTGRES_SOURCE_DB=ride_hailing
POSTGRES_SOURCE_USER=ride_user
POSTGRES_SOURCE_PASSWORD=CHANGE_ME

# Airflow metadata DB
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# Airflow secrets / bootstrap admin
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__CORE__SECRET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME
AIRFLOW_DAGS_PAUSED_AT_CREATION=false

# GCP / BigQuery
GCP_PROJECT_ID=taxi-pipeline-484508
GCP_CREDENTIALS_HOST_PATH=/home/void/credentials/service-account.json
BQ_RAW_DATASET=prod_raw_ride_hailing
BQ_ANALYTICS_DATASET=analytics_ride_hailing
BQ_MART_DATASET=mart_ride_hailing

# dbt
DBT_TARGET=prod

# Trino
TRINO_CATALOG_POSTGRES=postgresql
TRINO_CATALOG_BIGQUERY=bigquery

# Generator
GENERATOR_SEED=42
GENERATOR_BOOTSTRAP_DAYS=90
GENERATOR_BOOTSTRAP_RIDES_PER_DAY=2000
GENERATOR_CUSTOMER_COUNT=20000
GENERATOR_DRIVER_COUNT=2000
GENERATOR_INTERVAL_SECONDS=15
GENERATOR_RIDES_PER_TICK=5

TZ=Asia/Jakarta
